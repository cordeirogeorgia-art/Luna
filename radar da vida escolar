const todayISO = () => {
  const now = new Date();
  const offset = now.getTimezoneOffset() * 60000;
  return new Date(now.getTime() - offset).toISOString().slice(0, 10);
};

const fmt = (date) => {
  if (!date) return "";
  return new Date(`${date}T12:00:00`).toLocaleDateString("pt-BR", {
    day: "numeric",
    month: "short"
  });
};

const addDays = (dateStr, days) => {
  if (!dateStr) return "";
  const d = new Date(`${dateStr}T12:00:00`);
  d.setDate(d.getDate() + Number(days));
  return d.toISOString().slice(0, 10);
};

const initial = {
  profile: null,
  cycleLength: "28",
  periodLength: "5",
  lastPeriod: "",
  enabledPrediction: false,
  entries: {},
  notes: [],
  settings: { hideOnShared: false }
};

function loadData() {
  try {
    return { ...initial, ...JSON.parse(localStorage.getItem("luna-data") || "{}") };
  } catch {
    return initial;
  }
}

const saveData = (data) => {
  try {
    localStorage.setItem("luna-data", JSON.stringify(data));
